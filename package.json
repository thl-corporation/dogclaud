{
  "name": "dogclaud",
  "version": "1.0.0",
  "description": "Monitorea tu uso de tokens de Claude Code en tiempo real con datos reales y alertas inteligentes",
  "main": "dist-electron/main/index.js",
  "homepage": "https://github.com/thl-corporation-spa/dogclaud",
  "author": {
    "name": "Eliezer Lopez M.",
    "email": "admin@thlcorporation.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "vite build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "keywords": ["dogclaud", "claude", "claude-code", "usage", "tracker", "electron", "tokens"],
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-store": "^8.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.thlcorporation.dogclaud",
    "productName": "DogClaud",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "maintainer": "admin@thlcorporation.com",
      "icon": "assets/dog-emoji-512.png"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/dog-emoji-512.png"
    },
    "mac": {
      "target": ["zip"],
      "icon": "assets/dog-emoji-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
